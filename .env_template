VITE_API_BASE_URL=http://localhost:8000

# Classifier (TypeSafe System One / jev — see docs/Jev.md)
TYPESAFE_API_KEY=

# L2 supervisor (Helmcode OpenAI-compatible API; pin a Cerebras-class model id)
HELMCODE_BASE_URL=https://api.helmcode.com/v1
HELMCODE_API_KEY=
SUPERVISOR_MODEL=

# Per-run JSONL event tapes (forensics path in docs/Actions.md). Host-side,
# outside the ./backend bind mount. Default: /var/lib/hackspain/runs
RUN_LOG_DIR=/var/lib/hackspain/runs
ACTION_STEP_DELAY=0.35
# Shared secret required by POST /api/demo/incidents/{incident_id}/dispatch
ACTION_DISPATCH_TOKEN=

# Persistent event/entity graph (Neo4j). JSONL remains the recovery tape.
NEO4J_URI=bolt://neo4j-hackspain:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hackspain-local
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=true

# QuiverAI (SVG generate / edit / animate). Presentation-only for now.
# Docs: https://docs.quiver.ai/developers/quickstart
QUIVERAI_API_KEY=

# L4/L5 pager (HappyRobot outbound voice). scripts/page.sh and the demo
# dispatcher POST telefono from ONCALL_PHONE. The outbound To field reads
# that payload var. HAPPYROBOT_API_BASE is optional — derived from the hook
# host when empty (workflows.platform.eu.happyrobot.ai →
# https://platform.eu.happyrobot.ai/api/v2).
HAPPYROBOT_API_KEY=
HAPPYROBOT_WORKFLOW_ID=
HAPPYROBOT_HOOK_URL=
HAPPYROBOT_API_BASE=
HAPPYROBOT_POLL_INTERVAL=1.5
HAPPYROBOT_POLL_TIMEOUT=240
ONCALL_PHONE=+34644904044
ONCALL_NAME=Marc Altabella

# Containment: none = this project (docker pause / close ports / cut agentnet / stop agents); aws = ideal (IAM / IGW / NACL)
CLOUD=none
AGENT_BRIDGE=agentnet
AGENT_VPC_ID=
IGW_ID=
AGENT_NACL_ID=

# Malicious-agent harness (compose.agents.yaml — see docs/scenarios.md)
# Brain: Helmcode OpenAI-compatible API. AGENT_TOKEN must match a user:token
# line in proxy/tokens — it is the credential the sandbox presents to Squid.
AGENT_MODEL=deepseek-v4-flash
AGENT_TASK=Fix the failing test in /workspace.
EXFIL_URL=
RUN_ID=demo
AGENT_TOKEN=demo-token
MONITOR_API_URL=http://host.docker.internal:8000
CALLER_IDENTITY_STATE=unverified
INPUT_TRUST=untrusted
